<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.github.lindnergui.meraki</id>
  <name>Meraki</name>
  <summary>Player de música local e Subsonic</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>LicenseRef-proprietary</project_license>
  <developer id="com.github.lindnergui">
    <name>Guilherme Lindner</name>
  </developer>
  <description>
    <p>
      Meraki reúne bibliotecas locais e servidores Subsonic em um player de
      música rápido, responsivo e visualmente minimalista.
    </p>
  </description>
  <launchable type="desktop-id">com.github.lindnergui.meraki.desktop</launchable>
  <provides>
    <binary>meraki</binary>
    <mediatype>audio/mpeg</mediatype>
    <mediatype>audio/flac</mediatype>
    <mediatype>audio/ogg</mediatype>
    <mediatype>audio/x-wav</mediatype>
    <mediatype>audio/mp4</mediatype>
  </provides>
  <releases>
    <release version="0.1.0" date="2026-08-29"/>
  </releases>
  <content_rating type="oars-1.1">
    <content_attribute id="violence-cartoon">none</content_attribute>
  </content_rating>
  <url type="homepage">https://github.com/lindnergui/MERAKI</url>
  <url type="bugtracker">https://github.com/lindnergui/MERAKI/issues</url>
</component>
